# ── Anthropic ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Auth ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-32-char-random-string

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Genesys Cloud (Voice) ──────────────────────────────────────────────────────
GENESYS_NOTIFICATION_CHANNEL_URL=wss://streaming.{region}.pure.cloud/channels/{channelId}
GENESYS_ACCESS_TOKEN=

# ── Feature Flags ──────────────────────────────────────────────────────────────
ENABLE_OPS_GUIDANCE=false

# ── Service Ports (defaults) ───────────────────────────────────────────────────
API_GATEWAY_PORT=4000
GENESYS_ADAPTOR_PORT=4001
AI_ENGINE_PORT=4002
COMPLIANCE_ENGINE_PORT=4003
KNOWLEDGE_SERVICE_PORT=4004
